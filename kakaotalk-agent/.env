# ========================================================
# [SERVER] 중앙 오케스트레이터 서버 연동 설정
# ========================================================
SERVER_URL=ws://127.0.0.1:8080/ws/agent
SERVER_HEARTBEAT_INTERVAL=10
SERVER_RECONNECT_INTERVAL=2

# ========================================================
# [REDROID] Redroid 연결 설정 (주소 + 대수 지정 방식)
# ========================================================
# 1. Redroid가 떠 있는 IP/호스트 주소 (기본값: 127.0.0.1)
REDROID_HOST=127.0.0.1

# 2. 연동할 총 대수 (예: 20 대면 6001~6020 자동 연결)
REDROID_COUNT=20

# ========================================================
# [DOCKER] 컨테이너 런타임 설정
# ========================================================
AGENT_IMAGE=kakaotalk-agent:latest

# ========================================================
# [DEBUG] 디버그 로그 설정 (true 시 단계별 정밀 진단 로그 출력)
# ========================================================
AGENT_DEBUG_LOG=true
