# ========================================================
# [POSTGRES] PostgreSQL 환경 변수 및 성능 튜닝 설정
# ========================================================
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=zeus890!

# --------------------------------------------------------
# [성능 튜닝] 고사양 64GB RAM 머신 최적화 (Redroid 인스턴스 공존 환경)
# --------------------------------------------------------
# 도커 공유 메모리 (병렬 쿼리용)
POSTGRES_SHM_SIZE=2g

# 270대 단말 동시 쿼리 수용 (기본 100 -> 300)
PG_MAX_CONNECTIONS=300

# SSD/NVMe 스토리지 탐색 비용 (SSD 최적화)
PG_RANDOM_PAGE_COST=1.1
PG_EFFECTIVE_IO_CONCURRENCY=200

# 메모리 버퍼 최적화 (64GB RAM 기준 안정적인 고성능 세팅)
# - Redroid 20~40대 구동 메모리를 확보하면서도 DB 캐시를 극대화
PG_SHARED_BUFFERS=4GB
PG_EFFECTIVE_CACHE_SIZE=12GB
PG_WORK_MEM=32MB
PG_MAINTENANCE_WORK_MEM=512MB
