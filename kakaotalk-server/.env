# ========================================================
# [SERVER] Kakaotalk Server 런타임 환경 설정
# - 데이터베이스/JPA/보안 등 비즈니스 설정은 src/main/resources/application-{profile}.yml에서 단일 관리
# ========================================================
SERVER_PORT=8080
SERVER_IMAGE=kakaotalk-server:latest
SPRING_PROFILES_ACTIVE=prd
JAVA_OPTS=-Xms512m -Xmx1024m -Dh2.bindAddress=127.0.0.1
