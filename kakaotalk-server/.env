# ========================================================
# [SERVER] Kakaotalk Server 런타임 환경 설정
# - 데이터베이스/JPA/보안 등 비즈니스 설정은 src/main/resources/application-{profile}.yml에서 단일 관리
# ========================================================
SERVER_PORT=8080
SERVER_IMAGE=kakaotalk-server:latest
SPRING_PROFILES_ACTIVE=prd
JAVA_OPTS=-Xms2048m -Xmx4096m -Dfile.encoding=UTF-8

# (필요 시 외부 환경변수로 DB 접속 정보 오버라이드 가능)
# SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/kakaotalk_prd?currentSchema=kakaotalk
# SPRING_DATASOURCE_USERNAME=admin
# SPRING_DATASOURCE_PASSWORD=zeus890!
