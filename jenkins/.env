# ========================================================
# [JENKINS] Jenkins CI/CD 환경 변수 설정
# ========================================================
JENKINS_IMAGE=jenkins/jenkins:lts-jdk17
JENKINS_PORT=9090
JENKINS_AGENT_PORT=50000

# Docker 소켓(/var/run/docker.sock) 및 실행 권한을 위한 사용자 설정 (root)
JENKINS_USER=root

JENKINS_JAVA_OPTS=-Duser.timezone=Asia/Seoul -Dfile.encoding=UTF-8 -Xms512m -Xmx1024m
